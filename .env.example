# DZ: copy to .env. Everything here is optional — keys can be entered later in
# Settings (stored encrypted in DATA_DIR). Values here are used only when
# nothing is saved in Settings.

# Port on this machine
PORT=3300
# Where the database and generated files live
DATA_DIR=./data

APIMART_API_KEY=
APIMART_PROXY=
ATLAS_API_KEY=
# Atlas Cloud blocks some countries. Example: socks5h://127.0.0.1:1080
ATLAS_PROXY=

# Only for deploy/compose.host-network.example.yml
CLOUDFLARE_TUNNEL_TOKEN=
