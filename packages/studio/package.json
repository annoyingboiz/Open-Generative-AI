{
  "name": "studio",
  "version": "1.0.0",
  "description": "Director studio components (Image, Video, Cinema…) for our provider gateway",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/models.js": "./src/models.js",
    "./package.json": "./package.json",
    "./dist/tailwind.css": "./dist/tailwind.css",
    "./ImageStudio": "./src/components/ImageStudio.jsx",
    "./VideoStudio": "./src/components/VideoStudio.jsx",
    "./AudioStudio": "./src/components/AudioStudio.jsx",
    "./LipSyncStudio": "./src/components/LipSyncStudio.jsx",
    "./RecastStudio": "./src/components/RecastStudio.jsx",
    "./CinemaStudio": "./src/components/CinemaStudio.jsx",
    "./MarketingStudio": "./src/components/MarketingStudio.jsx",
    "./AiInfluencerStudio": "./src/components/AiInfluencerStudio.jsx",
    "./LayersStudio": "./src/components/LayersStudio.jsx",
    "./MotionControlStudio": "./src/components/MotionControlStudio.jsx"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "build": "npm run build:css && babel src --out-dir dist --extensions .js,.jsx"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.3"
  }
}
